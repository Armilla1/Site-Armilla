{
  // =============================================================================
  // appsettings.Development.json — AMBIENTE DE DESENVOLVIMENTO
  //
  // ⚠️  SEGREDOS — NÃO COMMITAR ESTE ARQUIVO COM VALORES REAIS
  //
  // Este arquivo está no .gitignore. Para configurar segredos locais use:
  //   dotnet user-secrets set "JWT:Secret" "sua-chave-local-forte-aqui"
  //   dotnet user-secrets set "Smtp:Usuario" "seu-usuario-mailtrap"
  //   dotnet user-secrets set "Smtp:Senha" "sua-senha-mailtrap"
  //   dotnet user-secrets set "Hardware:TokenDispositivo" "token-do-esp32"
  //
  // Ou crie um arquivo .env (já no .gitignore) e carregue via DotNetEnv.
  // Em produção: use variáveis de ambiente ou Azure Key Vault / AWS Secrets.
  // =============================================================================
  "ConnectionStrings": {
    // Server=.  → SQL Server local (instância padrão)
    // SQL Express: "Server=.\\SQLEXPRESS;..."
    // Porta específica: "Server=localhost,1433;..."
    "ArmillaDB": "Server=.;Database=ArmillaDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "JWT": {
    // NUNCA commite a chave real aqui.
    // Gere uma forte: openssl rand -base64 48
    // Depois configure via user-secrets ou variável de ambiente JWT__Secret
    "Secret": "PREENCHER_COM_CHAVE_FORTE_MINIMO_32_CHARS_NUNCA_COMMITAR",
    "Issuer": "armilla-api",
    "Audience": "armilla-app"
  },
  "Development": {
    // true → RequireHttpsMetadata=false no JWT e cookie Secure=false
    // Permite testar em http://localhost sem certificado SSL
    "IgnoreHttps": true
  },
  "Smtp": {
    // Para testes: crie conta gratuita em https://mailtrap.io → Sandbox → copie credenciais.
    // Para produção: Gmail (smtp.gmail.com, porta 587) com "Senha de App" do Google.
    // Configure via user-secrets: dotnet user-secrets set "Smtp:Usuario" "..."
    "Host": "smtp.mailtrap.io",
    "Port": 587,
    "Usuario": "PREENCHER_USUARIO_SMTP",
    "Senha": "PREENCHER_SENHA_SMTP",
    "RemetenteNome": "Armilla Segura",
    "RemetenteEmail": "naoresponda@armilla.app",
    "UsarSsl": true
  },
  "Email": {
    // "Smtp" usa EmailService.cs (Mailtrap/Gmail)
    // "Resend" usa ResendEmailService.cs (API HTTP simples, https://resend.com)
    "Provider": "Smtp"
  },
  "Resend": {
    "ApiKey": "PREENCHER_COM_SUA_API_KEY_DO_RESEND",
    "RemetenteEmail": "naoresponda@armilla.app",
    "RemetenteNome": "Armilla Segura"
  },
  "Hardware": {
    // Token único gravado no firmware do ESP32-C3 para autenticar a pulseira
    // em POST /api/ingestao/localizacao (IngestaoController.cs).
    // NOTA: a versão atual usa token POR PULSEIRA gravado em app.Pulseiras —
    // este campo ficou aqui por compatibilidade de documentação. Ver
    // PulseirasController.Conectar() para a geração do token por pulseira.
    // Gere: openssl rand -base64 32
    "TokenDispositivo": "PREENCHER_COM_TOKEN_ALEATORIO_NUNCA_COMMITAR"
  },
  "RateLimit": {
    // Valores mais permissivos em desenvolvimento para facilitar testes.
    // Em produção, estas chaves não existem → SecurityConfig.cs usa os padrões
    // restritivos definidos lá (10/5min para login, 3/hora para cadastro).
    "Login": {
      "PermitLimit": 50,
      "WindowMinutes": 1
    },
    "Cadastro": {
      "PermitLimit": 20,
      "WindowMinutes": 1
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Debug: mostra todos os logs de AuthController, SecurityConfig, etc. em dev
      "Armilla": "Debug"
    }
  }
}

