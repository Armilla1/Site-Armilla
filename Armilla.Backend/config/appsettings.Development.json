{
  // =============================================================================
  // appsettings.Development.json
  // LOCALIZAÇÃO: raiz do projeto backend (Armilla_Backend/)
  //
  // PROBLEMA CORRIGIDO: O arquivo estava nomeado "appsettings_Development.json"
  // (underscore). O ASP.NET Core espera "appsettings.Development.json" (ponto).
  // Com o nome errado, o servidor nunca carregava essas configs em dev, causando:
  //   - ConnectionString não encontrada → erro 500 em qualquer rota
  //   - JWT:Secret não carregado → InvalidOperationException na inicialização
  //   - IgnoreHttps false → RequireHttpsMetadata=true → tokens rejeitados em HTTP
  //
  // COMO FUNCIONA: o .NET carrega appsettings.json PRIMEIRO, depois sobrescreve
  // com appsettings.{ASPNETCORE_ENVIRONMENT}.json. Em dev, ASPNETCORE_ENVIRONMENT=Development.
  // =============================================================================
  "ConnectionStrings": {
    // Server=. → SQL Server local (instância padrão)
    // Se usar SQL Express: "Server=.\\SQLEXPRESS;..."
    // Se usar porta específica: "Server=localhost,1433;..."
    "ArmillaDB": "Server=.;Database=ArmillaDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "JWT": {
    // ATENÇÃO: Em produção, mova o Secret para variável de ambiente:
    //   $env:JWT__Secret = "sua-chave-super-secreta-producao"
    // Nunca commite a chave de produção no repositório.
    // Mínimo 32 caracteres (256 bits) — exigido pelo SecurityConfig.cs
    "Secret": "sua-chave-secreta-com-pelo-menos-32-caracteres-aqui",
    "Issuer": "armilla-api",
    "Audience": "armilla-app"
  },
  "Development": {
    // true → RequireHttpsMetadata=false no JWT
    // Permite testar com HTTP local (sem certificado SSL)
    // Em produção este arquivo não é carregado, então fica false automaticamente
    "IgnoreHttps": true
  },
  "Smtp": {
    // =============================================================================
    // NOVO — Configuração de envio de e-mail (confirmação de cadastro e recuperação
    // de senha). Você confirmou que isso NÃO existia antes. Preencha com uma conta
    // SMTP real para os e-mails funcionarem de verdade.
    //
    // SUGESTÃO PARA TESTAR RÁPIDO (sem enviar e-mails de verdade):
    //   Crie uma conta gratuita em https://mailtrap.io → "Sandbox" → copie as
    //   credenciais SMTP de teste e cole aqui. Você verá os e-mails chegarem
    //   na caixa de entrada virtual do Mailtrap, sem precisar de um e-mail real.
    //
    // SUGESTÃO PARA PRODUÇÃO:
    //   Gmail (smtp.gmail.com, porta 587) exige criar uma "Senha de App" em
    //   https://myaccount.google.com/apppasswords — a senha normal da conta
    //   Google NÃO funciona aqui por segurança do próprio Google.
    // =============================================================================
    "Host": "smtp.mailtrap.io",
    "Port": 587,
    "Usuario": "PREENCHER_USUARIO_SMTP",
    "Senha": "PREENCHER_SENHA_SMTP",
    "RemetenteNome": "Armilla Segura",
    "RemetenteEmail": "naoresponda@armilla.app",
    "UsarSsl": true
  },
  "Hardware": {
    // =============================================================================
    // NOVO — Token fixo que a pulseira física (ESP32-C3 + SIM800L) usa para se
    // autenticar no endpoint POST /api/ingestao/localizacao. Este MESMO valor
    // deve ser gravado como constante no firmware do ESP32.
    //
    // Gere um valor aleatório forte para produção, por exemplo executando no
    // terminal: openssl rand -base64 32
    // =============================================================================
    "TokenDispositivo": "troque-isto-por-um-valor-aleatorio-de-32-bytes-em-producao"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Mostra todos os logs do AuthController e SecurityConfig em dev
      "Armilla": "Debug"
    }
  }
}
